# Contact form delivery. Set these in the Vercel project (Production / Preview).
# Do not commit real values. WEB3FORMS_ACCESS_KEY is read on the server and passed
# to the browser form (Web3Forms keys are public). Do not add a NEXT_PUBLIC_ copy.
# If that key is missing, the form falls back to POST /api/contact (Resend).

# Route fallback when WEB3FORMS_ACCESS_KEY is missing. https://resend.com
RESEND_API_KEY=

# Verified sender. onboarding@resend.dev only delivers to the Resend account owner.
CONTACT_FROM_EMAIL="Hacksure Contatti <contatti@hacksure.it>"

# Inbox that receives leads. Defaults to info@hacksure.it when unset.
CONTACT_TO_EMAIL=info@hacksure.it

# Primary provider, called from the visitor's browser. https://web3forms.com
WEB3FORMS_ACCESS_KEY=
